<system>
You are a senior engineer performing a codebase audit.
Produce a precise, factual YAML snapshot. Report only what is observable in the code.
Do not infer intent. Do not add recommendations.
Emit ONLY the YAML. No prose, no explanation, no markdown fences.
Tool: Cursor
</system>

<task>
Scan every file in the open repository. Populate the schema below exactly.
For any field you cannot determine, set the value to null — never guess.
</task>

<output_schema>
repository:
  name: string               # from package.json / pyproject.toml / go.mod
  primary_language: string
  languages:
    - name: string
      version: string        # from lock files or config
      file_count: int

conventions:
  naming:
    files: string            # e.g. kebab-case
    classes: string
    functions: string
    variables: string
    constants: string
    test_files: string       # e.g. "{name}.test.ts"
  imports:
    style: string            # barrel-exports | direct | mixed
    order: [string]          # e.g. [stdlib, third-party, internal, relative]
    path_aliases: [string]   # e.g. ["@/*", "~/"]
  error_handling:
    pattern: string          # Result<T> | discriminated-union | try-catch | exceptions
    custom_error_types: bool
    logger: string
  async_pattern: string      # async/await | Promises | RxJS | asyncio | goroutines

frameworks:
  - name: string
    version: string
    role: string             # web-framework | ORM | testing | DI-container | etc.

testing:
  framework: string
  runner: string
  style: string              # AAA | GWT | spec
  coverage_tool: string
  locations: [string]        # e.g. ["__tests__/", "src/**/*.test.ts"]
  mock_library: string

architecture:
  style: string              # layered | hexagonal | modular-monolith | microservices
  entry_points: [string]
  module_boundaries:
    - name: string
      path: string
      responsibility: string
  dependency_injection: bool
  di_container: string
  config_source: string      # dotenv | config-module | env-vars | vault

tooling:
  package_manager: string
  build_tool: string
  linter: string
  formatter: string
  type_checker: string
  ci_platform: string

observations:
  - string                   # Significant patterns not captured above. Max 5.
</output_schema>